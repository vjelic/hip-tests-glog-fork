          "message": {
            "text": "\"Detected Use of Prohibited C Function (strncat)\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "catch/unit/device/hipDeviceGetUuid.cc"
                },
                "region": {
                  "startLine": 217,
                  "startColumn": 2,
                  "endLine": 217,
                  "endColumn": 51,
                  "charOffset": 6578,
                  "charLength": 49,
                  "snippet": {
                    "text": "strncat(command, \" | grep -i Uuid:\", COMMAND_LEN)",
                    "rendered": {
                      "text": "strncat(command, \" | grep -i Uuid:\", COMMAND_LEN)",
                      "markdown": "`strncat(command, \" | grep -i Uuid:\", COMMAND_LEN)`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "strncat adds the null terminator at character 'n + 1', rather than at the nth character. this frequently leads to the null terminator being added in the memory adjacent to the destination buffer, rather than in the destination buffer."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "catch/unit/device/hipDeviceGetUuid.cc"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "charOffset": 6578,
                        "charLength": 49
                      },
                      "insertedContent": {
                        "text": "strcat_s(command,  COMMAND_LEN,  \" | grep -i Uuid:\")"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "description": {
                "text": "strncat adds the null terminator at character 'n + 1', rather than at the nth character. this frequently leads to the null terminator being added in the memory adjacent to the destination buffer, rather than in the destination buffer."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
